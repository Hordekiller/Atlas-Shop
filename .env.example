# ===== Generic Shop Template =====
# این فایل شامل تمام متغیرهای محیطی مورد نیاز پروژه است.
# یک کپی با نام .env از این فایل بسازید و مقادیر واقعی را وارد کنید.

# ===== Database =====
# PostgreSQL connection string (required)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/shop_db?schema=public"

# ===== Seed =====
# Admin password for seed script (default: random 32-char hex if not set)
ADMIN_SEED_PASSWORD=""

# ===== JWT Authentication =====
# Secret key for signing JWT tokens (required - change in production)
JWT_SECRET="your-secret-key-change-in-production"
# Token expiration time (e.g., 7d, 24h)
JWT_EXPIRES_IN="7d"

# ===== Server =====
# API server port
PORT=8000
# Allowed CORS origins (comma-separated)
CORS_ORIGIN="http://localhost:3000,http://localhost:3001"

# ===== Payment Gateway: Zarinpal =====
# Merchant ID from Zarinpal dashboard
ZARINPAL_MERCHANT_ID="00000000-0000-0000-0000-000000000000"
# Callback URL after payment
ZARINPAL_CALLBACK_URL="http://localhost:8000/api/v1/payments/verify"

# ===== Mail / Email =====
# Mail server configuration for sending emails
MAIL_HOST="smtp.example.com"
MAIL_PORT="587"
MAIL_USER="your-email@example.com"
MAIL_PASS="your-password"
MAIL_FROM="noreply@example.com"

# ===== Encryption =====
# Key for encrypting sensitive data (32 characters recommended)
ENCRYPTION_KEY="change-this-to-random-32-chars-secret-key!!"

# ===== SMS / OTP =====
# SMS provider: "console" (development) or "kavenegar" (production)
SMS_PROVIDER="console"
# API key from Kavenegar dashboard (required when SMS_PROVIDER=kavenegar)
SMS_API_KEY=""
# Sender number registered in Kavenegar (required when SMS_PROVIDER=kavenegar)
SMS_SENDER=""

# ===== Frontend (Next.js) =====
# Public API URL for client-side requests
NEXT_PUBLIC_API_URL="http://localhost:8000/api/v1"
# Public media URL for serving uploaded files
NEXT_PUBLIC_MEDIA_URL="http://localhost:8000"
# Public site URL for SEO metadata, sitemap, robots, PWA manifest, JSON-LD
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Site brand name (used in titles, metadata, JSON-LD, headers, footers)
NEXT_PUBLIC_SITE_NAME="فروشگاه من"
# Short brand name (used in PWA manifest, footer logo, login page)
NEXT_PUBLIC_SITE_SHORT_NAME="فروشگاه"
# Site description (used in metadata, OG tags, JSON-LD)
NEXT_PUBLIC_SITE_DESCRIPTION="خرید آنلاین با بهترین قیمت‌ها و ضمانت اصالت کالا"

# ===== SSL / HTTPS =====
# Paths to SSL certificates (for production HTTPS via nginx)
# Leave empty to use HTTP-only mode
SSL_CERT_PATH="./nginx/ssl/fullchain.pem"
SSL_KEY_PATH="./nginx/ssl/privkey.pem"
